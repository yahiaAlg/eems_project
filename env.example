# Copy this file to ".env" and fill in real values to use PostgreSQL.
# If no .env file exists (or these vars are unset), the project falls
# back to the local sqlite3 database automatically — no config needed.

POSTGRES_DB=eems
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Bridge with the pedagogical app (ISI) ---
# Same value must be set on the ISI server. Empty = bridge disabled.
SYNC_SHARED_SECRET=
SYNC_DEFAULT_SESSION_SLUG=catalogue-eems
# 1 = publish formations coming from ISI immediately; 0 (default) = hidden until reviewed
SYNC_NEW_OFFERINGS_ACTIVE=0
